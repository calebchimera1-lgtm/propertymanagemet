// ─────────────────────────────────────────────────────────────────────────────
// Property Management SaaS — database schema (source of truth)
//
// Phase 1 covers identity and tenancy: organizations, users, sessions, roles,
// permissions, tokens, settings and the audit trail.
// Phase 2 adds the portfolio: properties, buildings, units and the staff
// assignments that scope a caretaker or accountant to particular properties.
// Phase 3 adds occupancy: tenants and the leases that put them in units.
// Phase 4 adds the money: rent records, payments, receipts and expenses.
// Operations arrive in Phase 5 as designed in docs/BLUEPRINT.md.
//
// Conventions (blueprint §7):
//   • ids are cuid strings — opaque, non-enumerable, safe in URLs
//   • money is Decimal(14,2), never Float (no money in this phase yet)
//   • every tenant-owned model carries organizationId and indexes it
//   • timestamps are UTC
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../packages/database/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum PropertyType {
  APARTMENT
  RESIDENTIAL
  COMMERCIAL
  OFFICE
  SHOPS
  WAREHOUSE
  MIXED_USE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitType {
  BEDSITTER
  STUDIO
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
  FOUR_BEDROOM
  SHOP
  OFFICE
  WAREHOUSE
  OTHER
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  ALIEN_ID
  MILITARY_ID
  OTHER
}

enum LeaseStatus {
  ACTIVE
  /// Derived, not hand-set: a scheduled job moves an ACTIVE lease here when its
  /// end date falls inside the organization's warning window.
  EXPIRING_SOON
  /// Derived: the end date has passed. The unit is NOT freed automatically —
  /// a tenant staying past the end date is normal, and pretending the unit is
  /// vacant would contradict what is actually happening on the ground.
  EXPIRED
  /// Explicit: someone ended the lease. This frees the unit.
  TERMINATED
}

enum RentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  /// Derived from the due date, never hand-set.
  OVERDUE
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  /// Payments are append-only: a mistake is voided, never edited or deleted.
  VOIDED
}

enum ExpenseCategory {
  MAINTENANCE
  REPAIRS
  SECURITY
  CLEANING
  WATER
  ELECTRICITY
  GARBAGE
  SALARIES
  INSURANCE
  TAXES
  MANAGEMENT
  CONSTRUCTION
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

enum RoleName {
  SUPER_ADMIN
  PROPERTY_OWNER
  PROPERTY_MANAGER
  ACCOUNTANT
  CARETAKER
  TENANT
}

// ── Tenancy ──────────────────────────────────────────────────────────────────

/// The tenant boundary. Every organization-owned row hangs off this table and
/// no query may ever cross it. See blueprint §9 for the four enforcement layers.
model Organization {
  id          String             @id @default(cuid())
  name        String
  /// Short uppercase code, unique platform-wide. Used in receipt numbers.
  code        String             @unique
  email       String?
  phone       String?
  addressLine String?
  city        String?
  county      String?
  country     String             @default("Kenya")
  currency    String             @default("KES")
  timezone    String             @default("Africa/Nairobi")
  logoUrl     String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  users            User[]
  roles            Role[]
  userRoles        UserRole[]
  sessions         Session[]
  settings         Settings?
  auditLogs        AuditLog[]
  properties       Property[]
  buildings        Building[]
  units            Unit[]
  staffAssignments StaffAssignment[]
  tenants          Tenant[]
  leases           Lease[]
  rentRecords      RentRecord[]
  payments         Payment[]
  receipts         Receipt[]
  expenses         Expense[]
  numberSequences  NumberSequence[]

  /// Referenced by the composite foreign keys below. Every child row carries
  /// organizationId as part of its foreign key, so a unit cannot point at a
  /// property in another organization even if every guard in the API failed.
  @@index([status])
}

/// Per-organization preferences. Created atomically with the organization so
/// no code path has to cope with a missing settings row.
model Settings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  /// Default day of month rent falls due for new leases. Capped at 28 so a
  /// lease can never generate an impossible date in February.
  defaultDueDay          Int      @default(5)
  receiptPrefix          String   @default("RCP")
  leaseExpiryWarningDays Int      @default(60)
  rentGenerationEnabled  Boolean  @default(true)
  /// Late fees are not implemented in V1; the flag exists so the setting can be
  /// switched on when the feature lands, not so the UI can pretend it works.
  lateFeeEnabled         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ── Identity ─────────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(cuid())
  organizationId   String
  /// Globally unique in V1: one account per email address, platform-wide, so
  /// signing in with an email alone is unambiguous. Membership of more than one
  /// organization would need a membership table and is out of V1 scope.
  email            String     @unique
  /// Argon2id hash. Excluded from every serializer; never logged, never returned.
  passwordHash     String
  fullName         String
  phone            String?
  avatarUrl        String?
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                  UserRole[]
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  auditLogs              AuditLog[]
  staffAssignments       StaffAssignment[]        @relation("AssignedStaff")
  assignmentsMade        StaffAssignment[]        @relation("AssignedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([email])
}

/// A logged-in browser. The cookie carries an opaque random token; only its
/// SHA-256 hash is stored here, so a database dump cannot be replayed as a login.
model Session {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  /// sha256(token). Unique so a token collision is impossible.
  tokenHash      String    @unique
  /// Per-session secret the double-submit CSRF token is derived from.
  csrfSecret     String
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  /// Ceiling for sliding expiry: the session dies here no matter how active it is.
  absoluteExpiresAt DateTime
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([organizationId])
}

// ── Authorization ────────────────────────────────────────────────────────────

/// System roles are seeded once with organizationId = NULL and shared by every
/// organization. The nullable column is kept so per-organization custom roles
/// can be added later without a breaking migration. Uniqueness is enforced by
/// two partial indexes (see the initial migration) because Postgres treats
/// NULLs as distinct in a plain composite unique index.
model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           RoleName
  label          String
  description    String
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@index([organizationId])
  @@index([name])
}

/// The permission catalogue. Rows mirror PERMISSIONS in @pm/types exactly; the
/// seed reconciles this table on every run.
model Permission {
  id          String   @id @default(cuid())
  /// e.g. "payments.create"
  key         String   @unique
  resource    String
  action      String
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  assignedById   String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organizationId])
  @@index([userId])
}

// ── Single-use tokens ────────────────────────────────────────────────────────

/// Only the hash is stored, exactly as with sessions. A stolen database row
/// cannot be turned back into a working reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Audit ────────────────────────────────────────────────────────────────────

/// Append-only. The authentication flows already write here in Phase 1; the
/// authorized read endpoint and UI land in Phase 5.
///
/// `actorEmail` is a snapshot so the trail stays readable after a user row is
/// removed, which is also why `userId` is nullable with onDelete: SetNull.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  actorEmail     String
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId])
  @@index([action])
}

// ── Portfolio (Phase 2) ──────────────────────────────────────────────────────

/// A site: an estate, a block of flats, a row of shops, a commercial building.
///
/// Note the `@@unique([organizationId, id])`. It exists so children can carry a
/// COMPOSITE foreign key that includes the tenant column — see Building and
/// Unit below. That makes a cross-organization reference impossible in the
/// database itself, not merely unlikely because the API checks for it.
model Property {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  propertyType   PropertyType   @default(RESIDENTIAL)
  description    String?
  addressLine    String?
  city           String?
  county         String?
  country        String         @default("Kenya")
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  imageUrl       String?
  status         PropertyStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  buildings        Building[]
  units            Unit[]
  staffAssignments StaffAssignment[]
  leases           Lease[]
  rentRecords      RentRecord[]
  payments         Payment[]
  receipts         Receipt[]
  expenses         Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, propertyType])
  @@index([organizationId, city])
}

/// A block within a property. "Block A", "Block B". Optional: a property with a
/// single structure can hold its units directly.
model Building {
  id             String         @id @default(cuid())
  organizationId String
  propertyId     String
  name           String
  description    String?
  floors         Int?
  status         BuildingStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Composite: the property must be in the SAME organization as this building.
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  units        Unit[]
  leases       Lease[]
  rentRecords  RentRecord[]
  payments     Payment[]
  expenses     Expense[]

  @@unique([organizationId, id])
  @@unique([propertyId, name])
  @@index([organizationId])
  @@index([organizationId, propertyId])
  @@index([organizationId, status])
}

/// The rentable thing. Everything financial in later phases hangs off a unit.
model Unit {
  id             String     @id @default(cuid())
  organizationId String
  propertyId     String
  /// Null when the property has no blocks and units attach to it directly.
  buildingId     String?
  unitNumber     String
  unitType       UnitType   @default(ONE_BEDROOM)
  floor          Int?
  bedrooms       Int?
  bathrooms      Int?
  /// Decimal, never Float. No money in this system is ever a binary fraction.
  monthlyRent    Decimal    @db.Decimal(14, 2)
  securityDeposit Decimal   @default(0) @db.Decimal(14, 2)
  status         UnitStatus @default(VACANT)
  waterMeterNumber       String?
  electricityMeterNumber String?
  description    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  /// Composite and optional. Restrict rather than SetNull: the foreign key
  /// includes the required organizationId, so a cascade-to-null would try to
  /// null the tenant column too and fail. Deleting a block instead detaches its
  /// units to the property first, in one transaction — see BuildingsService.
  building     Building?    @relation(fields: [organizationId, buildingId], references: [organizationId, id], onDelete: Restrict)
  leases       Lease[]
  rentRecords  RentRecord[]
  payments     Payment[]
  receipts     Receipt[]
  expenses     Expense[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, propertyId])
  @@index([organizationId, buildingId])
  @@index([organizationId, unitType])
}

/// Which properties a property-scoped staff member may see.
///
/// A CARETAKER or ACCOUNTANT with no rows here sees nothing — the scope fails
/// closed. Owners and managers are unrestricted within their organization and
/// have no rows at all.
model StaffAssignment {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  propertyId     String
  assignedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("AssignedStaff", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, propertyId])
}

// ── Occupancy (Phase 3) ──────────────────────────────────────────────────────

/// A person who rents, or has rented, a unit.
///
/// A tenant is not a User: they have no login in Version 1. The TENANT role
/// exists in the permission matrix for the Version 2 portal, at which point a
/// User row would be linked to this one.
model Tenant {
  id                    String   @id @default(cuid())
  organizationId        String
  fullName              String
  phone                 String
  email                 String?
  idType                IdType?
  /// National ID or passport number. Unique per organization when present —
  /// see the partial index in the migration, since NULLs must stay distinct.
  nationalId            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  occupation            String?
  address               String?
  photoUrl              String?
  notes                 String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leases       Lease[]
  rentRecords  RentRecord[]
  payments     Payment[]
  receipts     Receipt[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, fullName])
  @@index([organizationId, phone])
}

/// The agreement that puts a tenant in a unit.
///
/// `monthlyRent` and `securityDeposit` are COPIED from the unit at creation
/// rather than read through it. Raising a unit's rent must not silently rewrite
/// what a sitting tenant agreed to pay, and from Phase 4 every rent record is
/// generated from the lease's figure, not the unit's.
model Lease {
  id             String      @id @default(cuid())
  organizationId String
  tenantId       String
  propertyId     String
  buildingId     String?
  unitId         String
  startDate      DateTime    @db.Date
  /// Null for an open-ended lease. Nothing expires without one.
  endDate        DateTime?   @db.Date
  monthlyRent    Decimal     @db.Decimal(14, 2)
  securityDeposit Decimal    @default(0) @db.Decimal(14, 2)
  /// How much of the deposit has actually been received. Version 1 records the
  /// amount; a full refundable-deposit ledger (deductions, refunds on move-out)
  /// is deliberately out of scope.
  depositPaid    Decimal     @default(0) @db.Decimal(14, 2)
  /// Day of month rent falls due. Capped at 28 so every month has that date.
  dueDay         Int
  status         LeaseStatus @default(ACTIVE)
  terminatedAt   DateTime?
  terminationReason String?
  notes          String?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Composite foreign keys throughout: a lease cannot reference a tenant,
  /// property, building or unit belonging to another organization.
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  building     Building?    @relation(fields: [organizationId, buildingId], references: [organizationId, id], onDelete: Restrict)
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)
  rentRecords  RentRecord[]
  payments     Payment[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, status, endDate])
  @@index([organizationId, tenantId])
  @@index([organizationId, unitId])
  @@index([organizationId, propertyId])
}

// ── Money (Phase 4) ──────────────────────────────────────────────────────────

/// One month's rent charge for one lease.
///
/// `expectedAmount` is copied from the lease at generation, not read through it:
/// a rent review must not silently rewrite what past months were billed at.
///
/// `paidAmount` and `balance` are stored so "who owes money" is an indexed
/// query rather than an aggregate over every payment ever made. They are
/// derived values with one writer — the payment service, inside a transaction —
/// and a reconciliation test asserts across the whole database that
/// paidAmount == SUM(completed payments) and balance == expected - paid.
model RentRecord {
  id             String     @id @default(cuid())
  organizationId String
  leaseId        String
  tenantId       String
  propertyId     String
  buildingId     String?
  unitId         String
  /// First day of the rental month, at UTC midnight.
  periodStart    DateTime   @db.Date
  periodEnd      DateTime   @db.Date
  /// "2026-09". Human-facing and stable for grouping.
  periodLabel    String
  expectedAmount Decimal    @db.Decimal(14, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(14, 2)
  balance        Decimal    @db.Decimal(14, 2)
  dueDate        DateTime   @db.Date
  status         RentStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lease        Lease        @relation(fields: [organizationId, leaseId], references: [organizationId, id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  building     Building?    @relation(fields: [organizationId, buildingId], references: [organizationId, id], onDelete: Restrict)
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)
  payments     Payment[]

  /// The constraint that makes double-billing impossible. A cron re-run, a
  /// double click and a container restart mid-job all collapse into one row.
  @@unique([leaseId, periodStart])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, periodLabel])
  @@index([organizationId, tenantId])
  @@index([organizationId, propertyId])
  @@index([organizationId, leaseId, periodStart])
}

/// Money received. Append-only.
///
/// There is no `updatedAt` because there is no edit path: a mistake is voided
/// (audited, reverses the rent balance in a transaction) and re-recorded. An
/// editable payment is an unauditable one.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  tenantId       String
  propertyId     String
  buildingId     String?
  unitId         String
  leaseId        String
  /// Required in Version 1: every payment is against a specific month's charge,
  /// which is what makes the reconciliation invariant meaningful. Deposits are
  /// recorded on the lease (Lease.depositPaid), not as payments.
  rentRecordId   String
  amount         Decimal       @db.Decimal(14, 2)
  paymentDate    DateTime      @db.Date
  paymentMethod  PaymentMethod
  /// M-Pesa code, bank slip number, cheque number. Unique per organization and
  /// method when present, so the same transaction cannot be banked twice.
  reference      String?
  periodLabel    String?
  notes          String?
  status         PaymentStatus @default(COMPLETED)
  /// Set on creation from the request header, so a retried request replays the
  /// original response instead of taking the money twice.
  idempotencyKey String?
  recordedById   String?
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lease        Lease        @relation(fields: [organizationId, leaseId], references: [organizationId, id], onDelete: Restrict)
  rentRecord   RentRecord   @relation(fields: [organizationId, rentRecordId], references: [organizationId, id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  building     Building?    @relation(fields: [organizationId, buildingId], references: [organizationId, id], onDelete: Restrict)
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)
  receipt      Receipt?

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, paymentDate])
  @@index([organizationId, status])
  @@index([organizationId, tenantId])
  @@index([organizationId, propertyId])
  @@index([organizationId, rentRecordId])
  @@index([organizationId, paymentMethod])
}

/// Proof of payment. Immutable, and numbered without gaps.
///
/// Voiding a payment marks its receipt void; the number is retained and never
/// reused, because a missing number in a receipt book is what an auditor asks
/// about.
model Receipt {
  id             String        @id @default(cuid())
  organizationId String
  paymentId      String        @unique
  /// RCP-ABC-2026-000001
  receiptNumber  String
  tenantId       String
  propertyId     String
  unitId         String
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod
  reference      String?
  paymentDate    DateTime      @db.Date
  periodLabel    String?
  issuedById     String?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  unit         Unit         @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, id])
  /// One receipt per payment, and the composite key keeps the pair inside one
  /// organization — the one-to-one needs the unique on the defining side.
  @@unique([organizationId, paymentId])
  @@index([organizationId])
  @@index([organizationId, paymentDate])
  @@index([organizationId, tenantId])
}

/// Money spent on a property. Feeds the profit and loss report in Phase 6.
model Expense {
  id             String          @id @default(cuid())
  organizationId String
  propertyId     String
  buildingId     String?
  unitId         String?
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(14, 2)
  expenseDate    DateTime        @db.Date
  paymentMethod  PaymentMethod?
  vendor         String?
  reference      String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict)
  building     Building?    @relation(fields: [organizationId, buildingId], references: [organizationId, id], onDelete: Restrict)
  unit         Unit?        @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, expenseDate])
  @@index([organizationId, category])
  @@index([organizationId, propertyId])
}

/// Gapless per-organization counters.
///
/// A Postgres sequence would be simpler but leaks gaps on rollback and is
/// shared across tenants. This row is locked FOR UPDATE inside the payment
/// transaction, so a rolled-back payment takes its receipt number with it.
model NumberSequence {
  id             String   @id @default(cuid())
  organizationId String
  /// "RECEIPT"
  key            String
  year           Int
  lastValue      Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, year])
  @@index([organizationId])
}
