# ─────────────────────────────────────────────────────────────────────────────
# Property Management SaaS — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# The API validates this whole file at boot and refuses to start if it is wrong.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Docker Compose: host is "postgres". Running on the host directly: "localhost".
DATABASE_URL=postgresql://pm:pm_password@localhost:5432/property_management?schema=public
# Used only by the integration test suite. MUST point at a throwaway database.
TEST_DATABASE_URL=postgresql://pm:pm_password@localhost:5432/pm_test?schema=public

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
# Comma-separated allow-list. Never "*" — credentials are sent with every request.
CORS_ORIGIN=http://localhost:3000

# ── Sessions & cookies ──────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with:  openssl rand -base64 48
# Rotating this value invalidates every session, by design.
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
COOKIE_NAME=pm.sid
CSRF_COOKIE_NAME=pm.csrf
# Leave empty in development. In production use a leading dot: .example.com
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Password hashing (Argon2id) ─────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
# Required only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (V1 driver "console" logs the link instead of sending it) ─────────
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── Misc ────────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
LOG_LEVEL=debug
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi

# ── Frontend (public — must never contain a secret) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Auth rate-limit buckets (strict by default) ─────────────────────────────
# Raise only for an automated end-to-end run, never in production.
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_LIMIT=10
AUTH_SENSITIVE_LIMIT=5
