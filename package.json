{
  "name": "property-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm packages:build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @pm/api dev",
    "dev:web": "pnpm --filter @pm/web dev",
    "build": "pnpm db:generate && pnpm -r build",
    "start": "pnpm -r --parallel --filter \"./apps/*\" start",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @pm/api test",
    "test:e2e:api": "pnpm --filter @pm/api test:e2e",
    "test:web": "pnpm --filter @pm/web test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "db:seed": "pnpm packages:build && tsx prisma/seed/index.ts",
    "db:seed:demo": "pnpm packages:build && tsx prisma/seed/index.ts --demo",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "packages:build": "pnpm --filter \"./packages/*\" build"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed/index.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@pm/database": "workspace:*",
    "@pm/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "@pm/types": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
